<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>教師削除</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <h2><%= teacher.name %> を削除</h2>

    <p>本当に削除しますか？</p>

    <form action="/teacher/delete/<%= teacher.id %>" method="POST">
        <button type="submit">削除</button>
    </form>

    <p><a href="/teacher/dashboard">キャンセル</a></p>
</div>
</body>
</html>
