<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>生徒出席入力</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">
    <h2 class="title">出席入力フォーム</h2>

    <form action="/submit" method="POST">

        <label>学籍番号</label>
        <input type="text" name="studentId" placeholder="A1234567" required>

        <label>名前</label>
        <input type="text" name="name" placeholder="山田 太郎" required>

        <label>日付</label>
        <input type="date" name="date" required>

        <label>区分</label>
        <select name="status" required>
            <option value="欠席">欠席</option>
            <option value="遅刻">遅刻</option>
            <option value="早退">早退</option>
        </select>

        <label>担任の先生</label>
        <input type="text" name="teacher" placeholder="田中先生">

        <label>理由・メッセージ</label>
        <textarea name="message" rows="4" placeholder="理由を入力（任意）"></textarea>

        <button type="submit">送信</button>
    </form>

</div>

</body>
</html>
