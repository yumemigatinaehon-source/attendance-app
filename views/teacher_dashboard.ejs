<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>教師ダッシュボード</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<%- include("partials/header") %>

<div class="container">
    <h2>教師ダッシュボード</h2>

    <h3>教師一覧</h3>
    <ul>
        <% teachers.forEach(t => { %>
            <li><%= t.name %>（<%= t.email %>）</li>
        <% }) %>
    </ul>

    <a href="/teacher/add" class="btn">教師を追加</a><br>
    <a href="/teacher/edit" class="btn">メール変更</a><br>
    <a href="/teacher/delete" class="btn">教師を削除</a><br>

</div>

<%- include("partials/footer") %>

</body>
</html>
