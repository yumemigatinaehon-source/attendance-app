<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>教師ダッシュボード</title>
</head>
<body>

<h2>ようこそ <%= teacher.name %> さん</h2>

<h3>教師一覧</h3>
<ul>
    <% teachers.forEach(t => { %>
        <li><%= t.name %>（ID: <%= t.login_id %>）</li>
    <% }) %>
</ul>

<a href="/teacher/add">教師を追加</a><br>
<a href="/teacher/logout">ログアウト</a>

</body>
</html>
