<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>教師ダッシュボード</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include("partials/header") %>
<div class="container">
<h2>教師ダッシュボード</h2>
<a href="/teacher/add" class="btn">教師追加</a>

<h3>教師一覧</h3>
<ul>
<% teachers.forEach(t => { %>
<li><%= t.name %> (<%= t.email %>) <a href="/teacher/delete/<%= t.id %>">削除</a></li>
<% }) %>
</ul>

<h3>欠席・遅刻者連絡</h3>
<pre><%= csv %></pre>
</div>
<%- include("partials/footer") %>
</body>
</html>
