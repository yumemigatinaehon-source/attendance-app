<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>教師ログイン</title>
</head>
<body>
    <h2>教師ログイン</h2>

    <% if (error) { %>
        <p style="color:red;"><%= error %></p>
    <% } %>

    <form action="/teacher/login" method="POST">
        <label>ログインID</label>
        <input type="text" name="login_id" required>

        <button type="submit">ログイン</button>
    </form>
</body>
</html>
