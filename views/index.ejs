<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>出席・遅刻入力</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <%- include("partials/header") %>

  <div class="container">
    <h2>欠席・遅刻入力フォーム</h2>

    <form id="form">
      <label>出席番号</label>
      <input type="text" id="number" placeholder="例: 12" />

      <label>名前</label>
      <input type="text" id="name" placeholder="山田 太郎" required />

      <label>日付</label>
      <input type="date" id="date" required />

      <label>区分</label>
      <div class="row">
        <label class="inline"><input type="radio" name="type" value="欠席" checked /> 欠席</label>
        <label class="inline"><input type="radio" name="type" value="遅刻" /> 遅刻</label>
      </div>

      <label>担任の先生</label>
      <select id="homeroom">
        <% teachers.forEach(t => { %>
          <option value="<%= t.name %>"><%= t.name %></option>
        <% }) %>
      </select>

      <% for (let i=1;i<=4;i++) { %>
        <label><%= i %>限の先生</label>
        <select id="t<%= i %>">
          <% teachers.forEach(t => { %>
            <option value="<%= t.name %>"><%= t.name %></option>
          <% }) %>
        </select>
      <% } %>

      <label>メッセージ（任意）</label>
      <textarea id="message" rows="3" placeholder="理由など"></textarea>

      <button type="submit" class="primary">送信</button>
    </form>

    <p id="msg" style="text-align:center;margin-top:10px;color:green;"></p>
  </div>

  <%- include("partials/footer") %>
  <script src="/script.js"></script>
</body>
</html>
