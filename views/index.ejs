<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>出席入力フォーム</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">

    <h2>出席入力フォーム</h2>

    <form id="form">

        <label>名前</label>
        <input type="text" id="name" required>

        <label>学籍番号</label>
        <input type="text" id="studentId" required>

        <label>日付</label>
        <input type="date" id="date" required>

        <label>状態</label>
        <select id="status">
            <option value="欠席">欠席</option>
            <option value="遅刻">遅刻</option>
        </select>

        <label>担任の先生</label>
        <select id="teacher">
            <% teachers.forEach(t => { %>
                <option value="<%= t.name %>"><%= t.name %></option>
            <% }) %>
        </select>

        <label>1限の先生</label>
        <select id="class1">
            <% teachers.forEach(t => { %>
                <option value="<%= t.name %>"><%= t.name %></option>
            <% }) %>
        </select>

        <label>2限の先生</label>
        <select id="class2">
            <% teachers.forEach(t => { %>
                <option value="<%= t.name %>"><%= t.name %></option>
            <% }) %>
        </select>

        <label>3限の先生</label>
        <select id="class3">
            <% teachers.forEach(t => { %>
                <option value="<%= t.name %>"><%= t.name %></option>
            <% }) %>
        </select>

        <label>4限の先生</label>
        <select id="class4">
            <% teachers.forEach(t => { %>
                <option value="<%= t.name %>"><%= t.name %></option>
            <% }) %>
        </select>

        <label>理由（任意）</label>
        <textarea id="reason"></textarea>

        <button type="submit">送信</button>
    </form>

    <p id="msg"></p>

</div>

<script src="/script.js"></script>
</body>
</html>
