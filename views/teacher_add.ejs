<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>教師追加</title>
</head>
<body>

<h2>教師追加</h2>

<% if (error) { %>
<p style="color:red;"><%= error %></p>
<% } %>

<form action="/teacher/add" method="POST">
    <label>ログインID</label>
    <input type="text" name="login_id" required>

    <label>先生の名前</label>
    <input type="text" name="name" required>

    <button type="submit">追加</button>
</form>

</body>
</html>
