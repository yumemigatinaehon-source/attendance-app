<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>教師メール変更</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<%- include("partials/header") %>

<div class="container">

    <h2>教師メール変更</h2>

    <form action="/teacher/edit" method="POST">
        <label>現在のメール</label>
        <input type="email" name="oldEmail" required>

        <label>新しいメール</label>
        <input type="email" name="newEmail" required>

        <button type="submit">変更</button>
    </form>

</div>

<%- include("partials/footer") %>

</body>
</html>
